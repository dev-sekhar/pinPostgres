{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComplianceType",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "DRAFT",
        "ARCHIVED"
      ]
    }
  },
  "required": [
    "code",
    "name"
  ],
  "additionalProperties": false
}